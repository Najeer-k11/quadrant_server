# Copy to /etc/quadrant-example/app.env on a server, or to .env for Docker.
# No quotes, and no spaces around "=". This holds secrets: never commit a copy.

APP_ENV=production

# Generate each with: openssl rand -hex 32
ADMIN_TOKEN=
USER_TOKEN=

PORT=5050
# Only nginx on this machine should reach the app.
ADDRESS=127.0.0.1
# One proxy, nginx, in front of the app.
TRUSTED_PROXY_HOPS=1

# Keep at 1 until users are in a database. See lib/handlers/users.dart.
ISOLATES=1

# Set this only if a website on another origin calls this API from a browser.
# CORS_ORIGIN=https://www.example.com
